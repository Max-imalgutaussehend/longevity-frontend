VITE_API_BASE_URL=/api

# Sentry Error Tracking (https://sentry.io)
# Set VITE_SENTRY_DSN to enable error + session replay in the browser.
# SENTRY_AUTH_TOKEN, SENTRY_ORG, and SENTRY_PROJECT are only needed for
# source map uploads during 'vite build' in CI (set via CI secrets, not .env).
VITE_SENTRY_DSN=
VITE_COMMIT_SHA=dev
